# l'option MATHJAX_RELPATH.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise GENERATE_HTML soit définie sur YES.

USE_MATHJAX            = NO

# Avec MATHJAX_VERSION, il est possible de spécifier la version de MathJax a
# utiliser. Notez que les différentes versions de MathJax ont des exigences
# différentes en ce qui concerne les différents paramètres, il est donc possible
# que d'autres paramètres MathJax doivent également être modifies lors du
# passage entre les différentes versions de MathJax.
# Les valeurs possibles sont :MathJax_2, MathJax_3etMathJax_4.
# La valeur par défaut est : MathJax_2.
# Cette balise nécessite que la balise USE_MATHJAX soit définie sur YES.

MATHJAX_VERSION        = MathJax_2

# Lorsque MathJax est activé, vous pouvez définir le format de sortie par défaut
# a utiliser pour la sortie MathJax. Pour plus de détails sur le format de
# sortie, voir MathJax version 2 (see:
# https://docs.mathjax.org/en/v2.7/output.html), MathJax version 3 (see:
# https://docs.mathjax.org/en/v3.2/output/index.html) et MathJax version 4 (see:
# https://docs.mathjax.org/en/v4.0/output/index.htm).
# Les valeurs possibles sont :HTML-CSS (plus lent, mais avec la meilleure
# compatibilité. C'est le nom pour MathJax version 2, pour MathJax version 3
# cela sera traduit en chtml), NativeMML (c'est-à-dire MathML. Pris en charge
# uniquement pour MathJax 2. Pour MathJax version 3, chtml sera utilisé à la
# place.), chtml (C'est le nom pour MathJax version 3, pour MathJax version 2
# cela sera traduit en HTML-CSS)etSVG.
# La valeur par défaut est : HTML-CSS.
# Cette balise nécessite que la balise USE_MATHJAX soit définie sur YES.

MATHJAX_FORMAT         = HTML-CSS

# Lorsque MathJax est activé, vous devez spécifier l'emplacement relatif au
# répertoire de sortie HTML en utilisant l'option MATHJAX_RELPATH. Pour MathJax
# version 2, le répertoire de destination doit contenir le script MathJax.js.
# Par exemple, si le répertoire mathjax se trouve au même niveau que le
# répertoire de sortie HTML, alors MATHJAX_RELPATH doit être ../mathjax. Pour
# MathJax versions 3 et 4, le répertoire de destination doit contenir le script
# tex-<format>.js (ou <format> est chtml ou svg). La valeur par défaut pointe
# vers le Reseau de Distribution de Contenu MathJax pour que vous puissiez voir
# rapidement le résultat sans installer MathJax. Cependant, il est fortement
# recommandé d'installer une copie locale de MathJax depuis
# https://www.mathjax.org avant le déploiement. La valeur par défaut est :
# - dans le cas de MathJax version 2 : https://cdn.jsdelivr.net/npm/mathjax@2
# - dans le cas de MathJax version 3 : https://cdn.jsdelivr.net/npm/mathjax@3
# - dans le cas de MathJax version 4 : https://cdn.jsdelivr.net/npm/mathjax@4
# Cette balise nécessite que la balise USE_MATHJAX soit définie sur YES.

MATHJAX_RELPATH        = http://cdn.mathjax.org/mathjax/latest

# La balise MATHJAX_EXTENSIONS peut être utilisée pour spécifier un ou plusieurs
# noms d'extension MathJax qui doivent être activés pendant le rendu MathJax.
# Par exemple pour la version 2 de MathJax (voir
# https://docs.mathjax.org/en/v2.7/tex.html):
# MATHJAX_EXTENSIONS = TeX/AMSmath TeX/AMSsymbols
# Par exemple pour la version 3 de MathJax (voir
# https://docs.mathjax.org/en/v3.2/input/tex/extensions/):
# MATHJAX_EXTENSIONS = ams
# Par exemple pour la version 4 de MathJax (voir
# https://docs.mathjax.org/en/v4.0/input/tex/extensions/):
# MATHJAX_EXTENSIONS = units
# Notez que pour la version 4 de Mathjax, quelques extensions sont déjà
# automatiquement chargées. Pour désactiver un paquet dans la version 4 de
# Mathjax, on peut utiliser le nom du paquet précède d'un signe moins (- comme
# MATHJAX_EXTENSIONS += -textmacros)
# Cette balise nécessite que la balise USE_MATHJAX soit définie sur YES.

MATHJAX_EXTENSIONS     =

# La balise MATHJAX_CODEFILE peut être utilisée pour spécifier un fichier avec
# des morceaux de code JavaScript qui seront utilisés au démarrage du code
# MathJax. Voir le site Mathjax pour plus de détails:
# - MathJax version 2 (see:
# https://docs.mathjax.org/en/v2.7/)
# - MathJax version 3 (see:
# https://docs.mathjax.org/en/v3.2/)
# - MathJax version 4 (see:
# https://docs.mathjax.org/en/v4.0/)Pour un exemple, consultez la documentation.
# Cette balise nécessite que la balise USE_MATHJAX soit définie sur YES.

MATHJAX_CODEFILE       =

# Lorsque la balise SEARCHENGINE est activée, Doxygen générera une boite de
# recherche pour la sortie HTML. Le moteur de recherche sous-jacent utilise
# JavaScript et DHTML et devrait fonctionner sur tout navigateur moderne. Notez
# que lors de l'utilisation de l'aide HTML (GENERATE_HTMLHELP), de l'aide Qt
# (GENERATE_QHP) ou des docsets (GENERATE_DOCSET), il existe déjà une fonction
# de recherche, celle-ci devrait donc généralement être désactivée. Pour les
# grands projets, le moteur de recherche base sur JavaScript peut être lent,
# alors l'activation de SERVER_BASED_SEARCH peut fournir une meilleure solution.
# Il est possible de rechercher en utilisant le clavier; pour accéder à la boite
# de recherche, utilisez <touche d'accès> + S (ce qu'est la <touche d'accès>
# dépend de l'OS et du navigateur, mais c'est généralement <CTRL>,
# <ALT>/<option>, ou les deux). Dans la boite de recherche, utilisez la <touche
# curseur bas> pour accéder à la fenêtre des résultats de recherche, les
# résultats peuvent être navigues en utilisant les <touches curseur>. Appuyez
# sur <Entrée> pour sélectionner un élément ou <echap> pour annuler la
# recherche. Les options de filtre peuvent être sélectionnées lorsque le curseur
# est dans la boite de recherche en appuyant sur <Maj>+<curseur bas>. Ici aussi,
# utilisez les <touches curseur> pour sélectionner un filtre et <Entrée> ou
# <echap> pour activer ou annuler l'option de filtre.
# La valeur par défaut est : YES.
# Cette balise nécessite que la balise GENERATE_HTML soit définie sur YES.

SEARCHENGINE           = YES

# Lorsque la balise SERVER_BASED_SEARCH est activée, le moteur de recherche sera
# implémenté en utilisant un serveur Web au lieu d'un client Web utilisant
# JavaScript. Il existe deux types de recherche basée sur un serveur Web selon
# le paramètre EXTERNAL_SEARCH. Lorsqu'il est désactivé, Doxygen générera un
# script PHP pour la recherche et un fichier d'index utilisé par le script.
# Lorsque EXTERNAL_SEARCH est activé, l'indexation et la recherche doivent être
# fournies par des outils externes. Voir la section "External Indexing and
# Searching" pour plus de détails.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise SEARCHENGINE soit définie sur YES.

SERVER_BASED_SEARCH    = NO

# Lorsque la balise EXTERNAL_SEARCH est activée, Doxygen ne générera plus le
# script PHP pour la recherche. Au lieu de cela, les résultats de recherche sont
# écrits dans un fichier XML qui doit être traite par un indexeur externe.
# Doxygen invoquera un moteur de recherche externe pointe par l'option
# SEARCHENGINE_URL pour obtenir les résultats de recherche.
#
# Doxygen est fourni avec un exemple d'indexeur (doxyindexer) et de moteur de
# recherche (doxysearch.cgi) qui sont bases sur la bibliothèque de moteur de
# recherche open source Xapian (see:
# https://xapian.org/).
#
# Voir la section "External Indexing and Searching" pour plus de détails.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise SEARCHENGINE soit définie sur YES.

EXTERNAL_SEARCH        = NO

# Le SEARCHENGINE_URL doit pointer vers un moteur de recherche heberge par un
# serveur Web qui retourner les résultats de recherche lorsque EXTERNAL_SEARCH
# est activé.
#
# Doxygen est fourni avec un exemple d'indexeur (doxyindexer) et de moteur de
# recherche (doxysearch.cgi) qui sont bases sur la bibliothèque de moteur de
# recherche open source Xapian (see:
# https://xapian.org/). Voir la section "External Indexing and Searching" pour
# plus de détails.
# Cette balise nécessite que la balise SEARCHENGINE soit définie sur YES.

SEARCHENGINE_URL       =

# Lorsque SERVER_BASED_SEARCH et EXTERNAL_SEARCH sont tous deux activés, les
# données de recherche non indexées sont ecrites dans un fichier pour
# l'indexation par un outil externe. Avec la balise SEARCHDATA_FILE, le nom de
# ce fichier peut être spécifie.
# Le fichier par défaut est : searchdata.xml.
# Cette balise nécessite que la balise SEARCHENGINE soit définie sur YES.

SEARCHDATA_FILE        = searchdata.xml

# Lorsque SERVER_BASED_SEARCH et EXTERNAL_SEARCH sont tous deux activés, la
# balise EXTERNAL_SEARCH_ID peut être utilisée comme identifiant pour le projet.
# Ceci est utile en combinaison avec EXTRA_SEARCH_MAPPINGS pour rechercher dans
# plusieurs projets et rediriger les résultats vers le bon projet.
# Cette balise nécessite que la balise SEARCHENGINE soit définie sur YES.

EXTERNAL_SEARCH_ID     =

# La balise EXTRA_SEARCH_MAPPINGS peut être utilisée pour activer la recherche
# dans des projets Doxygen autres que celui défini par ce fichier de
# configuration, mais qui sont tous ajoutés au même index de recherche externe.
# Chaque projet doit avoir un identifiant unique défini via EXTERNAL_SEARCH_ID.
# Le mappage de recherche mappe ensuite l'identifiant vers un emplacement
# relatif ou la documentation peut être trouvée. Le format est:
# EXTRA_SEARCH_MAPPINGS = tagname1=loc1 tagname2=loc2 ...
# Cette balise nécessite que la balise SEARCHENGINE soit définie sur YES.

EXTRA_SEARCH_MAPPINGS  =

#---------------------------------------------------------------------------
# Options de configuration relatives à la sortie LaTeX
#---------------------------------------------------------------------------

# Si la balise GENERATE_LATEX est définie à YES, Doxygen générera une sortie
# LaTeX.
# La valeur par défaut est : YES.

GENERATE_LATEX         = NO

# La balise LATEX_OUTPUT est utilisée pour spécifier ou les docs LaTeX seront
# placées. Si un chemin relatif est entre, la valeur de OUTPUT_DIRECTORY sera
# mise devant.
# Le répertoire par défaut est : latex.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_OUTPUT           = latex

# La balise LATEX_CMD_NAME peut être utilisée pour spécifier le nom de la
# commande LaTeX a invoquer.
#
# Notez que lorsque USE_PDFLATEX n'est pas active, le défaut est latex, lorsque
# USE_PDFLATEX est activé, le défaut est pdflatex et dans ce dernier cas si
# latex est choisi, il est écrasé par pdflatex. Pour des langages de sortie
# spécifiques, le défaut peut avoir été défini différemment, cela dépend de
# l'implémentation du langage de sortie.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_CMD_NAME         = latex

# La balise MAKEINDEX_CMD_NAME peut être utilisée pour spécifier le nom de la
# commande pour générer l'index pour LaTeX.
# Note : Cette balise est utilisée dans le Makefile / make.bat.
# Voir aussi : LATEX_MAKEINDEX_CMD pour la partie dans le fichier de sortie
# généré (.tex).
# Le fichier par défaut est : makeindex.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

MAKEINDEX_CMD_NAME     = makeindex

# La balise LATEX_MAKEINDEX_CMD peut être utilisée pour spécifier le nom de la
# commande pour générer l'index pour LaTeX. S'il n'y a pas de barre oblique
# inverse (\) comme premier caractère, elle sera automatiquement ajoutée dans le
# code LaTeX.
# Note : Cette balise est utilisée dans le fichier de sortie généré (.tex).
# Voir aussi : MAKEINDEX_CMD_NAME pour la partie dans le Makefile / make.bat.
# La valeur par défaut est : makeindex.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_MAKEINDEX_CMD    = makeindex

# Si la balise COMPACT_LATEX est définie à YES, Doxygen génère des documents
# LaTeX plus compacts. Cela peut être utile pour les petits projets et peut
# aider a economiser quelques arbres en général.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

COMPACT_LATEX          = NO

# La balise PAPER_TYPE peut être utilisée pour définir le type de papier utilisé
# par l'imprimante.
# Les valeurs possibles sont :a4 (210 x 297 mm), letter (8,5 x 11 pouces), legal
# (8,5 x 14 pouces)etexecutive (7,25 x 10,5 pouces).
# La valeur par défaut est : a4.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

PAPER_TYPE             = a4

# La balise EXTRA_PACKAGES peut être utilisée pour spécifier un ou plusieurs
# noms de paquets LaTeX qui doivent être inclus dans la sortie LaTeX. Le paquet
# peut être spécifie simplement par son nom ou avec la syntaxe correcte a
# utiliser avec la commande LaTeX \usepackage. Pour obtenir la police times par
# exemple, vous pouvez spécifier:
# EXTRA_PACKAGES=times ou EXTRA_PACKAGES={times}
# Pour utiliser l'option intlimits avec le paquet amsmath, vous pouvez
# spécifier:
# EXTRA_PACKAGES=[intlimits]{amsmath}
# Si laissé vide, aucun paquet supplémentaire ne sera inclus.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

EXTRA_PACKAGES         =

# La balise LATEX_HEADER peut être utilisée pour spécifier un en-tête LaTeX
# défini par l'utilisateur pour le document LaTeX généré. L'en-tête doit
# contenir tout jusqu'au premier chapitre. S'il est laissé vide, Doxygen
# générera un en-tête standard. Il est fortement recommandé de commencer avec un
# en-tête par défaut en utilisant
# doxygen -w latex new_header.tex new_footer.tex new_stylesheet.sty
# puis de modifier le fichier new_header.tex. Voir aussi la section "Doxygen
# usage" pour plus d'informations sur la génération de l'en-tête par défaut que
# Doxygen utilise normalement.
#
# Note: N'utilisez un en-tête défini par l'utilisateur que si vous savez ce que
# vous faites!
# Note : L'en-tête est sujet à changement, donc vous devez généralement
# régénérer l'en-tête par défaut lors de la mise à jour vers une version plus
# récente de Doxygen.Pour une description des marqueurs et noms de blocs
# possibles, consultez la documentation.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_HEADER           =

# La balise LATEX_FOOTER peut être utilisée pour spécifier un pied de page LaTeX
# défini par l'utilisateur pour le document LaTeX généré. Le pied de page doit
# contenir tout après le dernier chapitre. S'il est laissé vide, Doxygen
# générera un pied de page standard. Voir LATEX_HEADER pour plus d'informations
# sur la génération d'un pied de page par défaut et les commandes spéciales qui
# peuvent être utilisées dans le pied de page. Voir aussi la section "Doxygen
# usage" pour plus d'informations sur la génération du pied de page par défaut
# que Doxygen utilise normalement. Note: N'utilisez un pied de page défini par
# l'utilisateur que si vous savez ce que vous faites!
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_FOOTER           =

# La balise LATEX_EXTRA_STYLESHEET peut être utilisée pour spécifier des
# feuilles de style LaTeX supplémentaires définies par l'utilisateur qui sont
# incluses après les feuilles de style standard créées par Doxygen. En utilisant
# cette option, on peut redéfinir certains aspects de style. Doxygen copiera les
# fichiers de feuille de style dans le répertoire de sortie.
# Note : L'ordre des fichiers de feuille de style supplémentaires est important
# (par exemple, la dernière feuille de style de la liste redéfinit les
# paramètres des précédentes dans la liste).
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_EXTRA_STYLESHEET =

# La balise LATEX_EXTRA_FILES peut être utilisée pour spécifier une ou plusieurs
# images supplémentaires ou autres fichiers sources qui doivent être copiés dans
# le répertoire de sortie LATEX_OUTPUT. Notez que les fichiers seront copiés
# tels quels; il n'y a pas de commandes ou de marqueurs disponibles.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_EXTRA_FILES      =

# Si la balise PDF_HYPERLINKS est définie à YES, le LaTeX généré est prepare
# pour la conversion en PDF (en utilisant ps2pdf ou pdflatex). Le fichier PDF
# contiendra des liens (tout comme la sortie HTML) au lieu de références de
# pages. Cela rend la sortie adaptée à la navigation en ligne en utilisant un
# lecteur PDF.
# La valeur par défaut est : YES.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

PDF_HYPERLINKS         = YES

# Si la balise USE_PDFLATEX est définie à YES, Doxygen utilisera le moteur comme
# spécifie avec LATEX_CMD_NAME pour générer le fichier PDF directement à partir
# des fichiers LaTeX. Définissez cette option à YES pour obtenir une
# documentation PDF de meilleure qualité.
#
# Voir aussi la section LATEX_CMD_NAME pour sélectionner le moteur.
# La valeur par défaut est : YES.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

USE_PDFLATEX           = YES

# La balise LATEX_BATCHMODE signale le comportement de LaTeX en cas d'erreur.
# Les valeurs possibles sont :NO identique a ERROR_STOP, YES identique a BATCH,
# BATCH En mode batch, rien n'est imprime sur le terminal, les erreurs defilent
# comme si <return> était appuye à chaque erreur; les fichiers manquants que TeX
# essaie de lire ou de demander à partir de l'entrée clavier (\read sur un flux
# d'entrée non ouvert) provoquent l'arret du travail, NON_STOP En mode nonstop,
# le message de diagnostic apparaîtra sur le terminal, mais il n'y a aucune
# possibilite d'interaction utilisateur comme en mode batch, SCROLL En mode
# scroll, TeX s'arrêtera uniquement pour les fichiers manquants a lire ou si une
# entrée clavier est nécessaireetERROR_STOP En mode errorstop, TeX s'arrêtera à
# chaque erreur, demandant l'intervention de l'utilisateur.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_BATCHMODE        = NO

# Si la balise LATEX_HIDE_INDICES est définie à YES, Doxygen n'inclura pas les
# chapitres d'index (tels que l'index des fichiers, l'index des composes, etc.)
# dans la sortie.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_HIDE_INDICES     = NO

# La balise LATEX_BIB_STYLE peut être utilisée pour spécifier le style a
# utiliser pour la bibliographie, par exemple plainnat ou ieeetr. Voir
# https://en.wikipedia.org/wiki/BibTeX et \cite pour plus d'informations.
# La valeur par défaut est : plainnat.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_BIB_STYLE        = plain

# La balise LATEX_EMOJI_DIRECTORY est utilisée pour spécifier le chemin (relatif
# ou absolu) à partir duquel les images emoji seront lues. Si un chemin relatif
# est entre, il sera relatif au répertoire LATEX_OUTPUT. Si laissé vide, le
# répertoire LATEX_OUTPUT sera utilisé.
# Cette balise nécessite que la balise GENERATE_LATEX soit définie sur YES.

LATEX_EMOJI_DIRECTORY  =

#---------------------------------------------------------------------------
# Options de configuration relatives à la sortie RTF
#---------------------------------------------------------------------------

# Si la balise GENERATE_RTF est définie à YES, Doxygen générera une sortie RTF.
# La sortie RTF est optimisée pour Word 97 et peut ne pas sembler tres jolie
# avec d'autres lecteurs/editeurs RTF.
# La valeur par défaut est : NO.

GENERATE_RTF           = NO

# La balise RTF_OUTPUT est utilisée pour spécifier ou les docs RTF seront
# placées. Si un chemin relatif est entre, la valeur de OUTPUT_DIRECTORY sera
# mise devant.
# Le répertoire par défaut est : rtf.
# Cette balise nécessite que la balise GENERATE_RTF soit définie sur YES.

RTF_OUTPUT             = rtf

# Si la balise COMPACT_RTF est définie à YES, Doxygen génère des documents RTF
# plus compacts. Cela peut être utile pour les petits projets et peut aider a
# economiser quelques arbres en général.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise GENERATE_RTF soit définie sur YES.

COMPACT_RTF            = NO

# Si la balise RTF_HYPERLINKS est définie à YES, le RTF généré contiendra des
# champs de lien hypertexte. Le fichier RTF contiendra des liens (tout comme la
# sortie HTML) au lieu de références de pages. Cela rend la sortie adaptée à la
# navigation en ligne en utilisant Word ou d'autres lecteurs compatibles Word
# qui prennent en charge ces champs.
#
# Note: WordPad (write) et d'autres ne prennent pas en charge les liens.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise GENERATE_RTF soit définie sur YES.

RTF_HYPERLINKS         = NO

# Charge les définitions de feuille de style à partir d'un fichier. La syntaxe
# est similaire au fichier de configuration de Doxygen, c'est-à-dire une serie
# d'affectations. Vous devez uniquement fournir des remplacements, les
# définitions manquantes sont définies a leur valeur par défaut.
#
# Voir aussi la section "Doxygen usage" pour plus d'informations sur la
# génération de la feuille de style par défaut que Doxygen utilise normalement.
# Cette balise nécessite que la balise GENERATE_RTF soit définie sur YES.

RTF_STYLESHEET_FILE    =

# Définit des variables optionnelles utilisées dans la génération d'un document
# RTF. La syntaxe est similaire au fichier de configuration de Doxygen. Un
# fichier d'extensions modèle peut être généré en utilisant doxygen -e rtf
# extensionFile.
# Cette balise nécessite que la balise GENERATE_RTF soit définie sur YES.

RTF_EXTENSIONS_FILE    =

# La balise RTF_EXTRA_FILES peut être utilisée pour spécifier une ou plusieurs
# images supplémentaires ou autres fichiers sources qui doivent être copiés dans
# le répertoire de sortie RTF_OUTPUT. Notez que les fichiers seront copiés tels
# quels; il n'y a pas de commandes ou de marqueurs disponibles.
# Cette balise nécessite que la balise GENERATE_RTF soit définie sur YES.

RTF_EXTRA_FILES        =

#---------------------------------------------------------------------------
# Options de configuration relatives à la sortie des pages de manuel
#---------------------------------------------------------------------------

# Si la balise GENERATE_MAN est définie à YES, Doxygen générera des pages de
# manuel pour les classes et les fichiers.
# La valeur par défaut est : NO.

GENERATE_MAN           = NO

# La balise MAN_OUTPUT est utilisée pour spécifier ou les pages de manuel seront
# placées. Si un chemin relatif est entre, la valeur de OUTPUT_DIRECTORY sera
# mise devant. Un répertoire man3 sera créé dans le répertoire spécifie par
# MAN_OUTPUT.
# Le répertoire par défaut est : man.
# Cette balise nécessite que la balise GENERATE_MAN soit définie sur YES.

MAN_OUTPUT             = man

# La balise MAN_EXTENSION détermine l'extension qui est ajoutée aux pages de
# manuel générées. Si la section du manuel ne commence pas par un chiffre, le
# chiffre 3 est ajouté au début. Le point (.) au début de la balise
# MAN_EXTENSION est optionnel.
# La valeur par défaut est : .3.
# Cette balise nécessite que la balise GENERATE_MAN soit définie sur YES.

MAN_EXTENSION          = .3

# La balise MAN_SUBDIR détermine le nom du répertoire créé dans MAN_OUTPUT dans
# lequel les pages de manuel sont placées. Par défaut, c'est man suivi de
# MAN_EXTENSION avec le . initial supprime.
# Cette balise nécessite que la balise GENERATE_MAN soit définie sur YES.

MAN_SUBDIR             =

