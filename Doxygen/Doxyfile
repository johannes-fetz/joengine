PLANTUML_INCLUDE_PATH  =

# La balise PLANTUMLFILE_DIRS peut être utilisée pour spécifier un ou plusieurs
# répertoires qui contiennent des fichiers PlantUml qui sont inclus dans la
# documentation (voir la commande \plantumlfile).

PLANTUMLFILE_DIRS      =

# Lors de l'utilisation de diagrammes Mermaid avec le rendu CLI, la balise
# MERMAID_PATH devrait être utilisée pour spécifier le répertoire ou
# l'exécutable mmdc (Mermaid CLI) peut être trouvé. Si laissé vide, le rendu
# basé sur CLI est désactivé. Pour la sortie HTML, le rendu côté client via
# JavaScript est utilisé par défaut et ne nécessite pas mmdc. Pour la sortie
# LaTeX/PDF, mmdc est requis pour pre-générer les images. Doxygen générera un
# avertissement lorsque le rendu CLI est nécessaire mais que mmdc n'est pas
# disponible.

MERMAID_PATH           =

# Lors de l'utilisation de diagrammes Mermaid, la balise MERMAID_CONFIG_FILE
# peut être utilisée pour spécifier un fichier de configuration JSON pour
# l'outil Mermaid CLI (mmdc). Ce fichier peut contenir des paramètres de thème
# et d'autres options de configuration Mermaid.

MERMAID_CONFIG_FILE    =

# La balise MERMAID_RENDER_MODE sélectionne la manière dont les diagrammes
# Mermaid sont rendus.
# Les valeurs possibles sont :AUTO (utiliser le rendu côté client pour HTML et
# mmdc pour LaTeX/PDF et autres formats. Si MERMAID_PATH n'est pas défini, les
# diagrammes non-HTML produiront un avertissement), CLI (utiliser l'outil mmdc
# pour pre-générer les images (nécessite Node.js et mermaid-js/mermaid-cli).
# Fonctionne pour tous les formats de sortie)etCLIENT_SIDE (integrer mermaid.js
# dans la sortie HTML pour le rendu côté client. Ne nécessite pas mmdc mais
# fonctionne uniquement pour la sortie HTML).
# La valeur par défaut est : AUTO.

MERMAID_RENDER_MODE    = AUTO

# La balise MERMAID_JS_URL spécifie l'URL à partir de laquelle charger
# mermaid.js lors de l'utilisation du rendu côté client (MERMAID_RENDER_MODE est
# CLIENT_SIDE ou AUTO). Le défaut pointe vers la dernière version Mermaid v11
# sur le CDN jsDelivr.
#
# L'URL CDN par défaut nécessite un accès Internet lors de la consultation de
# la documentation générée. Pour une utilisation hors ligne, telechargez
# mermaid.esm.min.mjs et définissez ceci sur un chemin relatif, ou utilisez
# MERMAID_RENDER_MODE=CLI pour pre-générer les images à la place.
# Exemples:
# - Dernière v11 (défaut):
# https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs
# - Version épinglée:
# https://cdn.jsdelivr.net/npm/mermaid@11.3.0/dist/mermaid.esm.min.mjs
# - Copie locale: ./mermaid.esm.min.mjs (l'utilisateur doit placer le fichier
# dans le répertoire de sortie HTML)
# La valeur par défaut est :
# https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs.

MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs

# La balise MERMAIDFILE_DIRS peut être utilisée pour spécifier un ou plusieurs
# répertoires qui contiennent des fichiers Mermaid qui sont inclus dans la
# documentation (voir la commande \mermaidfile).

MERMAIDFILE_DIRS       =

# La balise DOT_GRAPH_MAX_NODES peut être utilisée pour définir le nombre
# maximal de nœuds qui seront affichés dans le graphe. Si le nombre de nœuds
# dans un graphe devient supérieur à cette valeur, Doxygen tronquera le graphe,
# ce qui est visualise en représentant un nœud comme une boite rouge. Notez que
# si le nombre d'enfants directs du nœud racine dans un graphe est déjà
# supérieur à DOT_GRAPH_MAX_NODES, le graphe ne sera pas affiche du tout. Notez
# également que la taille d'un graphe peut être encore restreinte par
# MAX_DOT_GRAPH_DEPTH.
# Valeur minimum : 0, valeur maximum : 10000, valeur par défaut : 50.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

DOT_GRAPH_MAX_NODES    = 50

# La balise MAX_DOT_GRAPH_DEPTH peut être utilisée pour définir la profondeur
# maximale des graphes générés par dot. Une valeur de profondeur de 3 signifie
# que seuls les nœuds atteignables depuis la racine en suivant un chemin via au
# maximum 3 arêtes seront affichés. Les nœuds qui se trouvent plus loin du nœud
# racine seront omis. Notez que définir cette option à 1 ou 2 peut réduire
# considerablement le temps de calcul nécessaire pour les grandes bases de code.
# Notez également que la taille d'un graphe peut être encore restreinte par
# DOT_GRAPH_MAX_NODES. Utiliser une profondeur de 0 signifie aucune restriction
# de profondeur.
# Valeur minimum : 0, valeur maximum : 1000, valeur par défaut : 0.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

MAX_DOT_GRAPH_DEPTH    = 0

# Si la balise GENERATE_LEGEND est définie à YES, Doxygen générera une page de
# legende expliquant la signification des diverses boites et flèches dans les
# graphes générés par dot.
# Note : Cette balise nécessite que UML_LOOK ne soit pas défini, c'est-à-dire
# que la representation graphique interne de Doxygen pour les diagrammes
# d'héritage et de collaboration soit utilisée.
# La valeur par défaut est : YES.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

GENERATE_LEGEND        = YES

# Si la balise DOT_CLEANUP est définie à YES, Doxygen supprimera les fichiers
# intermédiaires qui sont utilisés pour générer les divers graphes.
#
# Note: Ce paramètre est utilisé non seulement pour les fichiers dot mais aussi
# pour les fichiers temporaires msc.
# La valeur par défaut est : YES.

DOT_CLEANUP            = YES

# Vous pouvez définir des diagrammes de séquence de messages dans les
# commentaires Doxygen en utilisant la commande \msc. Si la balise MSCGEN_TOOL
# est laissée vide (le défaut), Doxygen utilisera une version intégrée de
# l'outil mscgen pour produire les diagrammes. Alternativement, la balise
# MSCGEN_TOOL peut également spécifier le nom d'un outil externe. Par exemple,
# en specifiant prog comme valeur, Doxygen appellera l'outil comme prog -T
# <outfile_format> -o <outputfile> <inputfile>. L'outil externe devrait prendre
# en charge les formats de fichier de sortie "png", "eps", "svg" et "ismap".

MSCGEN_TOOL            =

# La balise MSCFILE_DIRS peut être utilisée pour spécifier un ou plusieurs
# répertoires qui contiennent des fichiers msc qui sont inclus dans la
# documentation (voir la commande \mscfile).

MSCFILE_DIRS           =
