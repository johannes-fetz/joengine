# d'activer les graphes d'appel uniquement pour les fonctions sélectionnées en
# utilisant la commande \callgraph. La désactivation d'un graphe d'appel peut
# être accomplie au moyen de la commande \hidecallgraph.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

CALL_GRAPH             = NO

# Si la balise CALLER_GRAPH est définie à YES, Doxygen générera un graphe de
# dépendance d'appelant pour chaque fonction globale ou méthode de classe.
#
# Notez que l'activation de cette option augmentera de manière significative le
# temps d'une exécution. Donc dans la plupart des cas, il sera préférable
# d'activer les graphes d'appelant uniquement pour les fonctions sélectionnées
# en utilisant la commande \callergraph. La désactivation d'un graphe d'appelant
# peut être accomplie au moyen de la commande \hidecallergraph.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

CALLER_GRAPH           = NO

# Si la balise GRAPHICAL_HIERARCHY est définie à YES, Doxygen générera une
# hiérarchie graphique de toutes les classes au lieu d'une textuelle.
# La valeur par défaut est : YES.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

GRAPHICAL_HIERARCHY    = YES

# Si la balise DIRECTORY_GRAPH est définie à YES, Doxygen montrera les
# dépendances d'un répertoire sur d'autres répertoires de manière graphique. Les
# relations de dépendance sont déterminées par les relations #include entre les
# fichiers dans les répertoires. L'activation explicite d'un graphe de
# répertoire, lorsque DIRECTORY_GRAPH est défini à NO, peut être accomplie au
# moyen de la commande \directorygraph. La désactivation d'un graphe de
# répertoire peut être accomplie au moyen de la commande \hidedirectorygraph.
# La valeur par défaut est : YES.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

DIRECTORY_GRAPH        = YES

# La balise DIR_GRAPH_MAX_DEPTH peut être utilisée pour limiter le nombre
# maximal de niveaux de sous-répertoires générés dans les graphes de dépendance
# de répertoire par dot.
# Valeur minimum : 1, valeur maximum : 25, valeur par défaut : 1.
# Cette balise nécessite que la balise DIRECTORY_GRAPH soit définie sur YES.

DIR_GRAPH_MAX_DEPTH    = 1

# La balise DOT_IMAGE_FORMAT peut être utilisée pour définir le format d'image
# des images générées par dot. Pour une explication des formats d'image, voir la
# section des formats de sortie dans la documentation de l'outil dot (Graphviz
# (see:
# https://www.graphviz.org/)).
#
# Notez que les formats svg:cairo et svg:cairo:cairo ne peuvent pas être
# utilisés en combinaison avec INTERACTIVE_SVG (le INTERACTIVE_SVG sera défini a
# NO).
# Les valeurs possibles sont :png, jpg, gif, svg, png:gd, png:gd:gd, png:cairo,
# png:cairo:gd, png:cairo:cairo, png:cairo:gdiplus, png:gdiplus,
# png:gdiplus:gdiplus, svg:cairo, svg:cairo:cairo, svg:svg, svg:svg:core,
# gif:cairo, gif:cairo:gd, gif:cairo:gdiplus, gif:gdiplus, gif:gdiplus:gdiplus,
# gif:gd, gif:gd:gd, jpg:cairo, jpg:cairo:gd, jpg:cairo:gdiplus, jpg:gd,
# jpg:gd:gd, jpg:gdiplusetjpg:gdiplus:gdiplus.
# La valeur par défaut est : png.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

DOT_IMAGE_FORMAT       = png

# Si DOT_IMAGE_FORMAT est défini a svg ou svg:svg ou svg:svg:core, cette option
# peut être définie à YES pour activer la génération d'images SVG interactives
# qui permettent le zoom et le panoramique.
#
# Notez que cela nécessite un navigateur moderne autre qu'Internet Explorer.
# Testes et fonctionnels: Firefox, Chrome, Safari et Opera.
#
# Notez que cette option sera automatiquement désactivée lorsque
# DOT_IMAGE_FORMAT est défini a svg:cairo ou svg:cairo:cairo.
# La valeur par défaut est : NO.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

INTERACTIVE_SVG        = NO

# La balise DOT_PATH peut être utilisée pour spécifier le chemin ou l'outil dot
# peut être trouvé. Si laissé vide, il est suppose que l'outil dot peut être
# trouvé dans le path.
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

DOT_PATH               =

# La balise DOTFILE_DIRS peut être utilisée pour spécifier un ou plusieurs
# répertoires qui contiennent des fichiers dot qui sont inclus dans la
# documentation (voir la commande \dotfile).
# Cette balise nécessite que la balise HAVE_DOT soit définie sur YES.

DOTFILE_DIRS           =

# Vous pouvez inclure des diagrammes faits avec dia dans la documentation
# Doxygen. Doxygen executera ensuite dia pour produire le diagramme et l'insérer
# dans la documentation. La balise DIA_PATH vous permet de spécifier le
# répertoire ou reside le binaire dia. Si laissé vide, dia est suppose être
# trouve dans le chemin de recherche par défaut.

DIA_PATH               =

# La balise DIAFILE_DIRS peut être utilisée pour spécifier un ou plusieurs
# répertoires qui contiennent des fichiers dia qui sont inclus dans la
# documentation (voir la commande \diafile).

DIAFILE_DIRS           =

# Lors de l'utilisation de PlantUML, la balise PLANTUML_JAR_PATH devrait être
# utilisée pour spécifier le chemin ou java peut trouver le fichier plantuml.jar
# ou le nom de fichier du fichier jar a utiliser. Si laissé vide, il est suppose
# que PlantUML n'est pas utilise ou appelé lors d'une étape de prétraitement.
# Doxygen générera un avertissement lorsqu'il rencontrera une commande \startuml
# dans ce cas et ne générera pas de sortie pour le diagramme.

PLANTUML_JAR_PATH      =

# Lors de l'utilisation de PlantUML, la balise PLANTUML_CFG_FILE peut être
# utilisée pour spécifier un fichier de configuration pour PlantUML.

PLANTUML_CFG_FILE      =

# Lors de l'utilisation de PlantUML, les chemins spécifiés sont recherches pour
