/*
** Jo Engine linker script
**
** 0x06004000 - ...        : program and user data, then the engine work area (VDP1 command lists, 3D buffers...)
** ...        - 0x060FBC00 : free (given to jo_malloc(), see jo_init_memory())
** 0x060FBC00 - 0x060FFC00 : master CPU stack
** 0x00200000 - ...        : the functions and data read rarely (JO_LOW_WORK_RAM_CODE, with
**                           JO_COMPILE_WITH_LOW_WORK_RAM_CODE = 1 in the makefile): stored after .data, copied to the
**                           low work RAM at startup (start.S), their place given to .bss; the low work RAM free from
**                           ___jo_low_work_ram_end (JO_LOW_WORK_RAM_FREE, jo_add_memory_zone() skips the functions)
*/
SECTIONS {
    JO_START 0x06004000 : {
        ___Start = .;
        KEEP(*(JO_START))
    }
    .text ALIGN(0x20) :
    {
        *(.text)
        *(.text.*)
        *(.strings)
        __etext = .;
    }
    .rodata ALIGN(0x20) :
    {
        *(.rodata)
        *(.rodata.*)
    }
    .tors ALIGN(0x10) :
    {
        ___ctors = . ;
        *(.ctors)
        ___ctors_end = . ;
        ___dtors = . ;
        *(.dtors)
        ___dtors_end = . ;
    }
    .data ALIGN(0x10) :
    {
        *(.data)
        *(.data.*)
        __edata = . ;
    }
    /* (the functions read rarely, see above: in the program file after .data, run in the low work RAM; empty without
       JO_COMPILE_WITH_LOW_WORK_RAM_CODE = 1) */
    ___jo_low_work_ram_load = ALIGN(__edata, 4);
    JO_LOW_WORK_RAM 0x00200000 : AT(___jo_low_work_ram_load)
    {
        ___jo_low_work_ram_start = . ;
        *(JO_LOW_WORK_RAM)
        *(JO_LOW_WORK_RAM.*)
        . = ALIGN(4);
        ___jo_low_work_ram_end = . ;
    }
    .bss ALIGN(__edata, 0x10) (NOLOAD) :
    {
        __bstart = . ;
        *(.bss)
        *(.bss.*)
        * ( COMMON )
        . = ALIGN(4);
        __bend = . ;
        _end = .;
    }
    JO_WORK ALIGN(0x4000) (NOLOAD) :
    {
        __jo_work_start = . ;
        /* (the buffers with a big alignment first, 16 KB at most: no hole between the others; the high work RAM between
           the end of the program and this area is given to jo_malloc()) */
        *(JO_WORK_ALIGNED)
        *(SORT_BY_ALIGNMENT(JO_WORK))
        . = ALIGN(4);
        __jo_work_end = . ;
    }
    /DISCARD/ :
    {
        *(.comment)
        *(.eh_frame)
        *(.eh_frame_hdr)
    }
}
ASSERT(__jo_work_end <= 0x060FBC00, "Program too big: the program and the engine work area overlap the stack at 0x060FBC00")
