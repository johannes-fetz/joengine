# The frames of the screens of the computers (their textures only): generated by tools/make_assets.py (Saturn axes), converted to cd/SCRFRM.JOM
mtllib scrfrm.mtl

vt 0 1
vt 1 1
vt 1 0
vt 0 0

v 0.00 -10.00 0.00 0.500 0.500 0.500
v 8.00 -10.00 0.00 0.500 0.500 0.500
v 8.00 0.00 0.00 0.500 0.500 0.500
v 0.00 0.00 0.00 0.500 0.500 0.500
v 10.00 -10.00 0.00 0.500 0.500 0.500
v 18.00 -10.00 0.00 0.500 0.500 0.500
v 18.00 0.00 0.00 0.500 0.500 0.500
v 10.00 0.00 0.00 0.500 0.500 0.500
usemtl m0
f 1/1 2/2 3/3 4/4
usemtl m1
f 5/1 6/2 7/3 8/4
